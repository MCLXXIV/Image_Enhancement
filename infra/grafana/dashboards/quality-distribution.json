{
  "title": "Enhancer - Quality distribution",
  "uid": "enhancer-quality",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["enhancer", "quality"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "brightness_mean - Δ avg (after - before, 5m)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(enhance_quality_after_sum{metric=\"brightness_mean\"}[5m])) / sum(rate(enhance_quality_after_count{metric=\"brightness_mean\"}[5m])) - sum(rate(enhance_quality_before_sum{metric=\"brightness_mean\"}[5m])) / sum(rate(enhance_quality_before_count{metric=\"brightness_mean\"}[5m]))",
          "legendFormat": "Δ brightness",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": -0.05 },
              { "color": "green", "value": 0 }
            ]
          }
        }
      }
    },
    {
